# Kubernetes kubeconfig
# Kubeconfig thường chứa certificate, token hoặc thông tin truy cập cluster.
terraform/k8s-config/*

# Chỉ cho phép commit tài liệu và file mẫu không chứa thông tin thật.
!terraform/k8s-config/README.md
!terraform/k8s-config/.gitkeep
!terraform/k8s-config/*.example.yaml
!terraform/k8s-config/*.example.yml

# Terraform generated files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Atlantis local Helm values and Helm cache
.helm/
terraform/atlantis/values.local.yaml
terraform/atlantis/*secret*.yaml
